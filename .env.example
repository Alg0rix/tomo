# Copy to .env next to docker-compose.yml before `docker compose up`.
# Required when binding 0.0.0.0 (assert_bind_safety refuses insecure defaults).

# Cookie signing secret — generate with: openssl rand -hex 32
TOMO_SESSION_SECRET=change-me-to-a-long-random-string

# Bootstrap admin password (seed only; change in UI after first login)
TOMO_ADMIN_PASSWORD=change-me

# Optional: pin Fernet master key for encrypted SQLite secrets.
# If unset, Tomo writes /data/home/.secret_key on first start (persist the volume!).
# TOMO_SECRET_KEY=

# Host port published to the machine (container always listens on 8787)
TOMO_PUBLISH_PORT=8787

# Image to run (default: GHCR latest). Examples:
# TOMO_IMAGE=ghcr.io/alg0rix/tomo:latest
# TOMO_IMAGE=ghcr.io/alg0rix/tomo:0.2.0
# TOMO_IMAGE=tomo:local   # after: docker compose build

# Behind a reverse proxy that strips spoofed X-Forwarded-For:
# TOMO_TRUST_PROXY=1
# TOMO_COOKIE_SECURE=1

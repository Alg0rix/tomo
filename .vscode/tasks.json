{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tomo: dev server",
      "type": "shell",
      "command": "uv run python -m app.main",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TOMO_RELOAD": "1",
          "TOMO_HOST": "0.0.0.0"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "tomo",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Uvicorn running.*",
          "endsPattern": ".*Application startup complete.*"
        }
      }
    },
    {
      "label": "Tomo: run app",
      "type": "shell",
      "command": "uv run python -m app.main",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TOMO_HOST": "0.0.0.0"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Tomo: stop server",
      "type": "shell",
      "command": "fuser -k 8787/tcp 2>/dev/null || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Tomo: sync deps",
      "type": "shell",
      "command": "uv sync",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}

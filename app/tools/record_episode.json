{
  "id": "record_episode",
  "name": "Record episode",
  "description": "Save a concrete past experience into episodic memory (structured experience, not raw chat).",
  "backend": "app.runtime.tools.record_episode",
  "schema": {
    "type": "function",
    "function": {
      "name": "record_episode",
      "description": "Persist one coherent experience for future retrieval. Prefer structured fields (objective, context, trajectory, outcome, reflection, evaluation). Freeform `content` is allowed as a fallback narrative. Episodic = what happened this time; not a general fact (remember) or preference (memory). Failures are valuable to record.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Short label for the episode."
          },
          "trigger": {
            "type": "object",
            "description": "What started the experience (type/source/description)."
          },
          "objective": {
            "type": "string",
            "description": "What the agent/user was trying to achieve."
          },
          "context_summary": {
            "type": "string",
            "description": "Relevant environment/constraints/entities at the time."
          },
          "trajectory_summary": {
            "type": "string",
            "description": "What was observed, decided, and tried (including failures)."
          },
          "actions": {
            "type": "array",
            "items": {},
            "description": "Optional list of key actions taken."
          },
          "observations": {
            "type": "array",
            "items": {},
            "description": "Optional key observations."
          },
          "decisions": {
            "type": "array",
            "items": {},
            "description": "Optional key decisions."
          },
          "outcome_status": {
            "type": "string",
            "description": "success | failure | partial | abandoned | blocked | unknown"
          },
          "outcome_summary": {
            "type": "string",
            "description": "What finally happened."
          },
          "reflection_summary": {
            "type": "string",
            "description": "What to remember from this experience."
          },
          "what_worked": {
            "type": "array",
            "items": { "type": "string" }
          },
          "what_failed": {
            "type": "array",
            "items": { "type": "string" }
          },
          "lessons": {
            "type": "array",
            "items": {},
            "description": "Lessons (strings or {statement, confidence})."
          },
          "importance": {
            "type": "number",
            "description": "0-1 how important this experience is for the future."
          },
          "confidence": {
            "type": "number",
            "description": "0-1 confidence in the account."
          },
          "utility": {
            "type": "number",
            "description": "0-1 likely future usefulness."
          },
          "content": {
            "type": "string",
            "description": "Optional freeform narrative if structured fields are incomplete."
          },
          "parent_episode_id": {
            "type": "string",
            "description": "Optional parent for hierarchical episodes."
          }
        },
        "required": []
      }
    }
  }
}

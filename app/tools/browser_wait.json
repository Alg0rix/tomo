{
  "id": "browser_wait",
  "name": "Browser Wait",
  "description": "Wait briefly for page activity (load / timeout).",
  "backend": "app.runtime.tools.browser_tools",
  "executor": "client",
  "target": "browser",
  "schema": {
    "type": "function",
    "function": {
      "name": "browser_wait",
